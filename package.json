{
    "name": "tickety-api",
    "version": "2.0.0",
    "description": "A wrapper for tickety's post api, now with v3 !",
    "type": "commonjs",
    "main": "./build/index.js",
    "module": "./build/index.mjs",
    "types": "./build/index.d.ts",
    "exports": {
        "types": "./build/index.d.ts",
        "import": "./build/index.mjs",
        "require": "./build/index.js"
    },
    "scripts": {
        "build": "npm run rollup src/index.js -o build/index.cjs -f cjs && npm run rollup src/index.js -o build/index.mjs -f esm && cp ./src/index.d.ts ./build",
        "rollup": "rollup"
    },
    "files": [
        "build",
        "README.md"
    ],
    "author": "OxyToan",
    "contributors": [
        "NotDemonix"
    ],
    "license": "ISC",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Its0xyToan/tickety-api.git"
    },
    "dependencies": {
        "express": "^4.19.2"
    },
    "bugs": {
        "url": "https://github.com/Its0xyToan/tickety-api/issues"
    },
    "homepage": "https://github.com/Its0xyToan/tickety-api#readme",
    "devDependencies": {
        "rollup": "^4.40.0"
    }
}
